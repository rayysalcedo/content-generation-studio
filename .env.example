# =====================================================================
# CC360 Course Studio — Environment Variables
# Copy this file to .env and fill in your actual values
# =====================================================================

# === Required for the studio (all features) ===

# Private Integration Token (PIT) for the test sub-account
# Create one in CC360: Settings → Private Integrations → +Create
# Required scopes: courses.write, products.write, products.readonly, medias.write, medias.readonly, locations.readonly
CC360_JWT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account location ID (from URL: /v2/location/{THIS_PART}/...)
CC360_LOCATION_ID=ITeSh9QmCqRSsZwtBCZX

# User ID (decoded from JWT 'authClassId' field — only used for some legacy paths)
CC360_USER_ID=4DFXFR68PN2HnaG69Eya

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model
# Recommended: gemini-2.0-flash (most reliable as of May 2026)
# Alternatives: gemini-2.5-flash (newer, sometimes overloaded), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# === Required ONLY for PDF attachment feature ===
# This is your live BROWSER JWT (NOT a PIT). Required for any operation
# that hits backend.leadconnectorhq.com — like attaching files to lessons.
# Expires in ~1 hour. Get a fresh one whenever:
#   1. Open CC360 in Chrome, log in
#   2. Open DevTools (F12) → Network tab
#   3. Click any request to backend.leadconnectorhq.com
#   4. In the Headers panel, find "authorization: Bearer eyJ..."
#   5. Copy the long string AFTER "Bearer " — that's your JWT
CC360_JWT_USER=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...your_long_jwt_here

# === Optional ===

# Default theme accent color (hex)
THEME_ACCENT=#6366f1

# Studio server port (defaults to 3000)
PORT=3000

# Regen limit per sub-account
REGEN_LIMIT=3

# === Required ONLY for the test-attach-pdf.js script ===
# A specific lesson UUID in your CC360 to attach the test PDF to
# Find one by navigating to a lesson edit page in CC360 — the URL contains:
#   /memberships/courses/posts/{THIS_IS_THE_POST_ID}/edit
TEST_POST_ID=27b938ec-c468-447c-9f89-8a08072d5ab0
