# =====================================================================
# Content Generation Studio — Environment Variables
# Copy this file to .env and fill in your actual values
# =====================================================================

# === GoHighLevel auth ===
# Pick ONE mode (or set both — OAuth is tried first, PIT is the fallback).
#
# --- Mode A: Private Integration (single sub-account, simplest) ---

# Private Integration Token (PIT) for the sub-account
# Create one in GoHighLevel: Settings → Private Integrations → +Create
# Scopes needed: courses.readonly courses.write medias.readonly medias.write
#                locations.readonly locations/customValues.readonly
#                locations/customValues.write (+ products.* if offered)
GHL_PIT_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account location ID (from URL: /v2/location/{THIS_PART}/...)
GHL_LOCATION_ID=

# Web-app origin of your platform (only change for white-label domains)
# GHL_APP_ORIGIN=https://app.gohighlevel.com

# === AI (Google Gemini) ===

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Text model: course structure, workbooks, funnel copy
#   gemini-3.7-flash (default, best) · gemini-3.5-flash · gemini-3.5-flash-lite (cheapest)
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Image model (Nano Banana): thumbnails + funnel images
#   gemini-3.1-flash-image (default) · gemini-3.1-flash-lite-image (cheapest, 1K only) · gemini-3-pro-image (best)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Image size class: 512 | 1K | 2K | 4K  (512 only on gemini-3.1-flash-image)
GEMINI_IMAGE_SIZE=1K

# FREE TIER: text models are free, image models are NOT (paid project only).
# Set AI_IMAGES=off to test everything else without thumbnails.
AI_IMAGES=off

# FREE TIER rate limits are low (roughly 10 requests/min on Flash models).
# These settings keep workbook generation under that; raise them on a paid tier.
AI_WORKBOOK_CONCURRENCY=3
AI_WORKBOOK_DELAY_MS=20000

# Paid tier: raise throughput
# AI_IMAGE_CONCURRENCY=3
# AI_IMAGE_DELAY_MS=500

# === Optional ===

# Live BROWSER JWT — ONLY needed for the "attach thumbnails" step, which uses
# the internal backend.leadconnectorhq.com API. Expires in ~1 hour.
# You can also paste it at /setup instead of setting it here.
# GHL_USER_JWT=eyJ...

# Studio server port (Render sets PORT automatically)
PORT=3000

# Regen limit per sub-account
REGEN_LIMIT=3

# --- Mode B: OAuth marketplace app (multi-tenant; required for snapshot push) ---
# Create an app at https://marketplace.gohighlevel.com (Distribution: Sub-Account,
# plus Agency for snapshots). Add <your-domain>/oauth/callback as a Redirect URL.
# Then open /oauth/install to connect each sub-account. See README for details.
# GHL_CLIENT_ID=
# GHL_CLIENT_SECRET=
# GHL_OAUTH_REDIRECT_URI=https://your-app.onrender.com/oauth/callback
# GHL_OAUTH_SCOPES=medias.readonly medias.write courses.readonly courses.write locations.readonly snapshots.readonly snapshots.write

# Token store for OAuth installs. Postgres recommended in production; without it
# tokens are kept in data/installations.json (lost on each Render deploy).
# Leave UNSET in PIT mode — an invalid URL will crash-loop the service.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
